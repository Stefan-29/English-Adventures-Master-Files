{
  "name": "grammar101-modals",
  "version": "2.0.0",
  "description": "Professional web-based learning platform for English modal verbs with interactive lessons, quizzes, and games",
  "type": "module",
  "main": "app.js",
  "scripts": {
    "start": "http-server dist -p ${PORT:-8001} -c-1",
    "serve": "npm start",
    "dev": "http-server . -p ${PORT:-8001} -c-1",
    "build": "node scripts/build-static-site.js",
    "export:content": "node scripts/supabase/export-content.js",
    "test": "node scripts/qa/verify-project.js",
    "lint": "eslint app.js modules",
    "clean": "rm -rf node_modules package-lock.json"
  },
  "keywords": [
    "education",
    "english",
    "grammar",
    "modal-verbs",
    "learning",
    "interactive",
    "e-learning",
    "accessibility",
    "responsive-design"
  ],
  "author": "Stefan-29",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Stefan-29/Grammar101---English---Modals.git"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "devDependencies": {
    "eslint": "^8.0.0",
    "http-server": "^14.0.0"
  },
  "optionalDependencies": {
    "dotenv": "^16.0.0"
  }
}
