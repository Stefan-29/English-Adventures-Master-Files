{
  "lessonActivities": [
    {
      "id": "lesson-1",
      "title": "10.2 After Certain Verbs (Gerund)",
      "content": "<p>Use gerund after verbs such as admit, avoid, consider, delay, deny, finish, give up, imagine, involve, keep, mention, miss, postpone, suggest.</p>",
      "examples": ["He admitted taking the money.", "She suggested meeting at 5."],
      "difficulty": 2,
      "audio": "lc2_gerund.mp3",
      "functions": ["Identify gerund verbs", "Use gerund patterns"],
      "tips": "Common gerund verbs express feelings, habits, or mental actions."
    },
    {
      "id": "lesson-2",
      "title": "10.2 After Certain Verbs (Infinitive)",
      "content": "<p>Use infinitive after verbs such as afford, agree, arrange, ask, choose, need, fail, help, learn, manage, offer, refuse, seem, wait.</p>",
      "examples": ["He agreed to help.", "They promised to arrive early."],
      "difficulty": 2,
      "audio": "lc2_infinitive.mp3",
      "functions": ["Identify infinitive verbs", "Apply infinitive patterns"],
      "tips": "Infinitive verbs often express intentions, plans, or decisions."
    }
  ],
