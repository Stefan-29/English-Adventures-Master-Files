    {"id":"quiz-3","question":"Pick correct form","sentence":"I avoid ___ sugar.","options":["eat","to eat","eating","ate"],"correctAnswer":"eating","audio":"after_quiz3.mp3","hint":"Avoid + gerund.","difficulty":"easy","explanation":"Avoid requires gerund."},
    {"id":"quiz-4","question":"Pick correct form","sentence":"They plan ___ abroad next year.","options":["travel","traveling","to travel","traveled"],"correctAnswer":"to travel","audio":"after_quiz4.mp3","hint":"Plan + infinitive.","difficulty":"easy","explanation":"Plan requires infinitive."},
    {"id":"quiz-5","question":"Pick correct form","sentence":"It's no use ___ this problem.","options":["to solve","solving","solve","solved"],"correctAnswer":"solving","audio":"after_quiz5.mp3","hint":"No use + gerund.","difficulty":"medium","explanation":"No use is followed by gerund."},
