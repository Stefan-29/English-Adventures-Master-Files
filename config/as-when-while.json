          "arrive",
          "depart"
        ]
      },
      {
        "title": "Sentence Starters / Useful Phrases",
        "words": [
          "When + subject + verb, ...",
          "While + subject + verb + -ing, ...",
          "As + subject + verb, ...",
          "Just as ... , so ...",
          "Whenever + subject + verb, ...",
          "Each time + subject + verb, ...",
          "The moment + subject + verb, ...",
          "... when/while/as + subject + verb"
        ]
      }
    ]
