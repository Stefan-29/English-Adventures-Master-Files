{
  "siteSettings": {
    "title": "English Adventures: As, When, While",
    "favicon": "favicon.ico"
  },
  
  "lesson": {
    "title": "Time Markers: As, When, While Differences",
    "modules": [
      {
        "id": "lesson-module",
        "name": "Learn",
        "title": "Time Marker Lessons",
        "instructions": "Master as (progression), when (specific moment), and while (duration) to express timing relationships. Understand the key distinction: when marks a point in time, while emphasizes duration, as shows progression."
      },
      {
        "id": "writing-module",
        "name": "Write",
        "title": "Writing Practice",
        "instructions": "Write sentences using when (for specific moments), while (for simultaneous ongoing actions), and as (for progressive action) to describe temporal relationships. Apply correct comma rules for time clauses."
      },
      {
        "id": "game-module",
        "name": "Play",
        "title": "Time Marker Games",
        "instructions": "Play games to practice choosing between as, when, and while in different time contexts. Recognize signal words and understand temporal relationships."
      },
      {
        "id": "spelling-module",
        "name": "Apply",
        "title": "Time Marker Challenge",
        "instructions": "Apply time markers correctly in complex temporal sentences and master the subtle distinctions. Spell time-related grammar terminology."
      }
    ]
  },
  
  "wordBank": {
    "categories": [
      {
        "title": "Time Markers - Core Differences",
        "words": [
