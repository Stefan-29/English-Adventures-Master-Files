{
  "siteSettings": {
    "title": "English Adventures: Compound & Collective Nouns",
    "favicon": "favicon.ico"
  },

  "lesson": {
    "title": "Nouns: Compound & Collective",
    "modules": [
      {
        "id": "lesson-module",
        "name": "Learn",
        "title": "Compound & Collective Noun Lessons",
        "instructions": "Master compound nouns (two or more words as one unit) and collective nouns (groups of people, animals, or things)."
      },
      {
        "id": "writing-module",
        "name": "Write",
        "title": "Writing Practice",
        "instructions": "Write sentences using compound and collective nouns correctly. Practice with appropriate verbs and pronouns."
      },
      {
        "id": "game-module",
        "name": "Play",
        "title": "Grammar Games",
        "instructions": "Play games to practice identifying compound nouns, collective nouns, and choosing correct verb agreement."
      },
      {
        "id": "quiz-module",
        "name": "Quiz",
        "title": "Quick Quiz",
        "instructions": "Test your knowledge with multiple choice questions about compound and collective nouns. Choose the correct usage!"
      },
      {
        "id": "spelling-module",
        "name": "Apply",
        "title": "Nouns Challenge",
        "instructions": "Apply compound and collective noun rules correctly in sentences. Master verb agreement and plural formation."
      }
    ]
  },

  "wordBank": {
    "categories": [
      {
        "title": "Compound Nouns (Noun + Noun)",
