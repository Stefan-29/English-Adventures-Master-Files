{
  "siteSettings": {
    "title": "English Adventures: Linking Words and Connectors",
    "favicon": "favicon.ico"
  },
  
  "lesson": {
    "title": "Linking Words, Connectors & Transition Phrases",
    "modules": [
      {
        "id": "lesson-module",
        "name": "Learn",
        "title": "Linking Word Lessons",
        "instructions": "Master linking words for addition, contrast, cause-effect, comparison, sequence, and conclusion to connect ideas logically. Understand how different linking words create different relationships between ideas."
      },
      {
        "id": "writing-module",
        "name": "Write",
        "title": "Writing Practice",
        "instructions": "Write sentences using addition words (and, moreover, furthermore), contrast words (but, however, although), cause-effect words (because, therefore, so), and conclusion words (in conclusion, to summarize)."
      },
      {
        "id": "game-module",
        "name": "Play",
        "title": "Linking Word Games",
        "instructions": "Play games to practice choosing appropriate linking words in different contexts. Recognize relationships between ideas and select the correct connector."
      },
      {
        "id": "spelling-module",
        "name": "Apply",
        "title": "Linking Word Challenge",
        "instructions": "Apply linking words strategically in complex paragraphs and academic writing. Spell connector terminology and master multi-linking strategies."
      }
    ]
  },
  
