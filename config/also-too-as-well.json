      {
        "id": "lesson-module",
        "name": "Learn",
        "title": "Also, Too & As well Lessons",
        "instructions": "Master also, too, and as well to add agreeing thoughts in positive sentences, and either for negative sentences. Understand position rules and formal vs informal usage."
      },
      {
        "id": "writing-module",
        "name": "Write",
        "title": "Writing Practice",
        "instructions": "Write sentences using also in different positions, too and as well at the end of clauses, and either in negative sentences. Apply formal and informal registers."
      },
      {
        "id": "game-module",
        "name": "Play",
        "title": "Grammar Games",
        "instructions": "Play games to practice placing also, too, and as well correctly, and choosing between too and either in positive and negative contexts."
      },
      {
        "id": "spelling-module",
        "name": "Apply",
        "title": "Also, Too & As well Challenge",
        "instructions": "Apply also, too, as well, and either correctly in complex sentences. Master formal usage and sentence-initial also."
      }
    ]
  },
