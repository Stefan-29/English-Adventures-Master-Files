{
  "siteSettings": {
    "title": "English Adventures: Comparatives & Superlatives",
    "favicon": "favicon.ico"
  },

  "lesson": {
    "title": "Comparative & Superlative Adjectives",
    "modules": [
      {
        "id": "lesson-module",
        "name": "Learn",
        "title": "Comparatives & Superlatives Lessons",
        "instructions": "Master one-syllable -er/-est forms, two-syllable more/most forms, -y adjective changes, and irregular forms to compare people, places, and things accurately. Understand when to use comparative vs superlative."
      },
      {
        "id": "writing-module",
        "name": "Write",
        "title": "Writing Practice",
        "instructions": "Write sentences using comparative forms with 'than', superlative forms with 'the', and irregular comparisons (good/better/best). Apply spelling rules for doubled consonants and -y to -i changes in real contexts."
      },
      {
        "id": "game-module",
        "name": "Play",
        "title": "Grammar Games",
        "instructions": "Play games to practice choosing between comparative (-er/more) and superlative (-est/most) forms, and between regular and irregular adjectives. Recognise key signals like 'than' and 'in the world'."
      },
      {
        "id": "spelling-module",
        "name": "Apply",
        "title": "Comparatives & Superlatives Challenge",
        "instructions": "Apply -er/-est suffixes, more/most structures, -y to -i spelling changes, and irregular forms correctly in sentences. Master double-consonant spelling rules for short adjectives."
      }
    ]
  },

