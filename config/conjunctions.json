{
  "siteSettings": {
    "title": "English Adventures: Conjunctions",
    "favicon": "favicon.ico"
  },
  
  "lesson": {
    "title": "Conjunctions & Coordinating vs. Subordinating",
    "modules": [
      {
        "id": "lesson-module",
        "name": "Learn",
        "title": "Conjunctions Lessons",
        "instructions": "Master coordinating conjunctions (FANBOYS), subordinating conjunctions, and correlative conjunctions to connect ideas logically. Understand the key distinction: coordinating joins equal clauses, subordinating joins dependent to independent clauses."
      },
      {
        "id": "writing-module",
        "name": "Write",
        "title": "Writing Practice",
        "instructions": "Write sentences using coordinating conjunctions (and, but, or, so), subordinating conjunctions (because, although, when, if), and correlative conjunctions (both...and, either...or) to combine related ideas. Apply comma rules correctly."
      },
      {
        "id": "game-module",
        "name": "Play",
        "title": "Conjunction Games",
        "instructions": "Play games to practice choosing between coordinating, subordinating, and correlative conjunctions in various contexts. Recognize signal words and understand how they determine conjunction choice."
      },
      {
        "id": "spelling-module",
        "name": "Apply",
        "title": "Conjunction Challenge",
        "instructions": "Apply conjunctions correctly in complex sentences and master the subtle differences between types. Spell conjunction-related grammar terminology."
      }
    ]
  },
  
