{
  "siteSettings": {
    "title": "English Adventures: Compound Adjectives",
    "favicon": "favicon.ico"
  },

  "lesson": {
    "title": "Compound Adjectives",
    "modules": [
      {
        "id": "lesson-module",
        "name": "Learn",
        "title": "Compound Adjectives Lessons",
        "instructions": "Master adjective+noun, noun+adjective, adjective+participle, noun+participle, adverb+participle, and number+noun compound forms to describe people, places, and things with precision. Understand hyphenation rules and how position changes meaning."
      },
      {
        "id": "writing-module",
        "name": "Write",
        "title": "Writing Practice",
        "instructions": "Write sentences using compound adjectives in both pre-noun (hyphenated) and post-verb (unhyphenated) positions. Apply adjective+noun, noun+present participle, and number+noun patterns in real contexts."
      },
      {
        "id": "game-module",
        "name": "Play",
        "title": "Grammar Games",
        "instructions": "Play games to practice identifying compound adjective types, choosing hyphenated versus unhyphenated forms, and matching compound adjectives to their definitions. Recognise common patterns like well-known and record-breaking."
      },
      {
        "id": "spelling-module",
        "name": "Apply",
        "title": "Compound Adjectives Challenge",
        "instructions": "Apply hyphenation rules and compound adjective structures in context. Master number+noun compounds (five-day, ten-minute) and advanced forms like idiomatic phrase adjectives (once-in-a-lifetime)."
      }
    ]
  },

